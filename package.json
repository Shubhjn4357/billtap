{
  "name": "vahi",
  "main": "expo-router/entry",
  "version": "3.0.1",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "node ./scripts/run-doctor.js",
    "android:signing-info": "node ./scripts/android-signing-info.js",
    "version:bump": "node ./scripts/bump-version.js",
    "build:web": "expo export --platform web --clear",
    "routes:check": "node ./scripts/validate-routes.mjs",
    "api:routes:check": "node ./scripts/validate-api-routes.mjs",
    "contracts:check": "npm run routes:check && npm run api:routes:check",
    "smoke:e2e": "node ./scripts/smoke-e2e.mjs",
    "apk:build:preview": "npm run smoke:e2e && eas build --platform android --profile preview",
    "apk:build:production": "npm run smoke:e2e && eas build --platform android --profile production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@codearcade/expo-razorpay": "^1.5.0",
    "@docren/react-native-markdown": "^0.8.5",
    "@expo/vector-icons": "^15.0.3",
