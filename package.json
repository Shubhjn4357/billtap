{
  "name": "vahi",
  "main": "expo-router/entry",
  "version": "4.1.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:web": "expo export --platform web --clear",
    "smoke:web": "node ./scripts/smoke-web.js",
    "smoke:routes": "node ./scripts/smoke-routes.js",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "verify:api-contract": "node ./scripts/verify-api-contract.js",
    "verify:platform-contract": "node ./scripts/verify-platform-contract.js",
    "verify:routes": "node ./scripts/validate-routes.js",
    "verify:invoice-snapshots": "node ./scripts/verify-invoice-html-snapshots.js",
    "verify:invoice-snapshots:update": "node ./scripts/verify-invoice-html-snapshots.js --update",
    "verify:fast": "pnpm run doctor && pnpm run lint && pnpm run typecheck",
    "verify:ci": "pnpm run verify:fast && pnpm run verify:routes && pnpm run smoke:routes && pnpm run verify:invoice-snapshots",
    "verify:full": "pnpm run verify:ci && pnpm run smoke:web",
    "verify:prepush": "pnpm run verify:ci",
    "verify:workspace": "node ./scripts/verify-workspace.js",
    "test:verify": "node --test ./tests/unit/**/*.test.js",
    "apk:build:preview": "eas build --platform android --profile preview",
    "apk:build:production": "eas build --platform android --profile production",
    "doctor": "node ./scripts/run-doctor.js",
    "keystore:base64": "node ./scripts/generate-base64.js",
    "secrets:push": "node ./scripts/push-gh-secrets.js",
    "secrets:push:dry": "node ./scripts/push-gh-secrets.js --dry-run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/bottom-tabs": "^7.7.3",
    "@react-navigation/elements": "^2.8.1",
    "@react-navigation/native": "^7.1.28",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "date-fns": "^4.1.0",
    "expo": "~55.0.4",
    "expo-background-task": "^55.0.9",
    "expo-camera": "~55.0.9",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "^55.0.10",
    "expo-device": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.7",
    "expo-haptics": "~15.0.8",
    "expo-image": "~55.0.5",
    "expo-linking": "~55.0.7",
    "expo-notifications": "^55.0.10",
    "expo-print": "~55.0.8",
    "expo-router": "~55.0.3",
    "expo-secure-store": "~55.0.8",
    "expo-sharing": "~55.0.11",
    "expo-splash-screen": "~55.0.10",
    "expo-sqlite": "^55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-task-manager": "^55.0.9",
    "expo-web-browser": "~55.0.9",
    "immer": "^11.1.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.3",
    "eslint-config-expo": "~55.0.0",
    "expo-doctor": "1.17.14",
    "lodash.debounce": "^4.0.8",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-dev-client",
        "expo-haptics"
      ]
    }
  },
  "private": true
}
