    "@types/react": "~19.1.17",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
