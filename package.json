{
  "name": "vahi-backend",
  "private": true,
  "version": "2.1.0",
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "verify:ci": "npm run typecheck && npm run test:accounting-invariants && npm run verify:runtime",
    "verify:runtime": "node ./scripts/run-runtime-smoke-if-configured.mjs",
    "verify:full": "npm run verify:ci && npm run verify:runtime",
    "db:generate": "drizzle-kit generate",
    "db:repair": "node ./scripts/normalizeSubscriptionStatus.cjs",
    "db:push": "npm run db:repair && node -r ./scripts/drizzleDnsPatch.cjs ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node -r ./scripts/drizzleDnsPatch.cjs ./node_modules/drizzle-kit/bin.cjs studio",
    "test:accounting-invariants": "node ./scripts/accounting-invariants.mjs",
    "test:runtime:all": "node ./scripts/runtime-smoke-all.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.45.1",
    "google-auth-library": "^10.5.0",
    "hono": "^4.11.9",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240923.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "pg": "^8.18.0",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.66.0"
  }
}
