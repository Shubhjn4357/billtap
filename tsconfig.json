{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist"
  },
  "include": ["api/**/*.ts", "src/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
