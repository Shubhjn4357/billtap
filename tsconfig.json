{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
    "esModuleInterop": true
  },
  "include": ["api/**/*.ts", "src/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
