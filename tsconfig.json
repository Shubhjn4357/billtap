{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "types/**/*.ts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["server/**/*","client-admin/**/*"]
}
