{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/**/*.ts": {
            "includeFiles": "src/**"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/[[...route]]"
        }
    ],
    "crons": [
        {
            "path": "/api/jobs/run-all",
            "schedule": "0 2 * * *"
        }
    ]
}