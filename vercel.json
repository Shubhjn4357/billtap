{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/[[...route]]"
        }
    ],
    "crons": [
        {
            "path": "/api/jobs/run-all",
            "schedule": "0 2 * * *"
        }
    ]
}