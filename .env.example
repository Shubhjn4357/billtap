# Backend API base URL
# Local: http://localhost:8787/api
# Production: https://<your-worker-domain>/api
EXPO_PUBLIC_API_BASE_URL=https://your-worker-domain/api

# Payment mode toggle
EXPO_PUBLIC_ENABLE_LIVE_PAYMENTS=false

# WhatsApp delivery mode
# device = opens WhatsApp app with prefilled message (zero-cost)
# cloud = send via backend/provider
EXPO_PUBLIC_WHATSAPP_DELIVERY_MODE=device

# Google OAuth client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
