# Database
DATABASE_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require

# Auth
API_JWT_SECRET=replace_with_strong_secret

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_IDS=web_client_id.apps.googleusercontent.com,android_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=

# Developer admin allowlist
DEVELOPER_ADMIN_UIDS=
DEVELOPER_ADMIN_EMAILS=
APK_OWNER_UID=

# Scheduled jobs security
CRON_SECRET=replace_with_cron_secret
OTP_RETENTION_HOURS=24

# Payments (optional)
PAYMENT_PROVIDER=mock
CHECKOUT_BASE_URL=https://example.com/checkout
PAYMENT_WEBHOOK_SECRET=

# Optional CORS origin CSV
CORS_ORIGINS=

# Media uploads (Cloudflare R2) optional
MEDIA_UPLOAD_SECRET=
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_UPLOAD_MB=10

# WhatsApp provider (optional cloud mode)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Twilio OTP (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
