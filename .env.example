# ========================================
# BACKEND API CONFIGURATION
# ========================================
# Backend API base URL (REQUIRED)
# For local dev: http://localhost:3000/api
# For production: https://your-backend.vercel.app/api
# This should match your deployed backend URL
EXPO_PUBLIC_API_BASE_URL=https://your-backend-domain.vercel.app/api

# ========================================
# PAYMENT CONFIGURATION
# ========================================
# Enable live payment processing (default: false for demo mode)
# Set to 'true' only when backend has real payment provider configured
EXPO_PUBLIC_ENABLE_LIVE_PAYMENTS=false

# ========================================
# GOOGLE OAUTH CONFIGURATION
# ========================================
# Google OAuth Web Client ID (REQUIRED for all platforms)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Create "Web application" type OAuth 2.0 Client ID
# This is used for server-side authentication
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Google OAuth Android Client ID (REQUIRED for Android builds)
# Create "Android" type OAuth 2.0 Client ID
# You'll need your app's SHA-1 fingerprint and package name
# Get SHA-1: keytool -keystore ~/.android/debug.keystore -list -v -alias androiddebugkey
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# Google OAuth iOS Client ID (REQUIRED for iOS builds)
# Create "iOS" type OAuth 2.0 Client ID
# You'll need your app's bundle identifier from app.json
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
