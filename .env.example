# ========================================
# DATABASE CONFIGURATION
# ========================================
# Neon PostgreSQL connection string
# Get from: https://console.neon.tech → Your Project → Connection Details
# Must include ?sslmode=require for secure connections
DATABASE_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require

# ========================================
# AUTHENTICATION & SECURITY
# ========================================
# Secret key for signing JWT tokens (REQUIRED)
# Generate: openssl rand -base64 32
# Minimum 32 characters recommended
API_JWT_SECRET=replace_with_strong_secret

# Google OAuth 2.0 Client ID (REQUIRED for Google Sign-In)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Create OAuth 2.0 Client ID with type "Web application"
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ========================================
# PAYMENT CONFIGURATION
# ========================================
# Payment provider: 'mock', 'stripe', or 'razorpay'
# Use 'mock' for testing without real payments
PAYMENT_PROVIDER=mock

# Base URL for payment checkout page in your client app
# Used to redirect users after payment initiation
CHECKOUT_BASE_URL=https://example.com/checkout

# Secret for verifying payment webhook signatures (REQUIRED for production payments)
# For Stripe: Get from Stripe Dashboard → Webhooks → Signing secret
# For Razorpay: Get from Settings → Webhooks → Secret
# Generate random: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_secret

# ========================================
# CRON JOB SECURITY
# ========================================
# Secret to authenticate cron job requests (RECOMMENDED)
# Prevents unauthorized access to /api/jobs/* endpoints
# Generate: openssl rand -hex 24
# Set the same value in Vercel cron job headers
CRON_SECRET=replace_with_cron_secret

# ========================================
# TWILIO SMS (OPTIONAL - for production phone OTP)
# ========================================
# Without Twilio, phone OTP returns testCode in API response
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
